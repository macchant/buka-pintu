---
import Layout from '../layouts/Layout.astro';
import FeaturedBooks from '../components/FeaturedBooks.jsx';
import HeroBackground from '../components/HeroBackground.jsx';

const stats = [
  { value: '2.500+', label: 'Judul Buku', icon: 'fa-book' },
  { value: '1.200+', label: 'Pengguna Aktif', icon: 'fa-users' },
  { value: '50+', label: 'Organisasi Partner', icon: 'fa-handshake' },
  { value: '100%', label: 'Gratis & Terbuka', icon: 'fa-unlock' },
];

const steps = [
  { num: '01', title: 'Cari Buku', desc: 'Temukan ribuan buku gratis dari berbagai kategori.', icon: 'fa-search' },
  { num: '02', title: 'Baca Online', desc: 'Buka dan baca langsung di browser tanpa perlu mengunduh.', icon: 'fa-laptop' },
  { num: '03', title: 'Unduh PDF', desc: 'Simpan ke Google Drive Anda untuk dibaca kapan saja.', icon: 'fa-download' },
];

const categories = [
  { name: 'Pengembangan Diri', count: 420, icon: 'fa-brain', color: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300', hoverColor: 'hover:bg-amber-50 dark:hover:bg-amber-900/60 hover:shadow-amber-200/50 dark:hover:shadow-amber-500/20', href: '/katalog' },
  { name: 'Keterampilan Kerja', count: 318, icon: 'fa-tools', color: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300', hoverColor: 'hover:bg-blue-50 dark:hover:bg-blue-900/60 hover:shadow-blue-200/50 dark:hover:shadow-blue-500/20', href: '/katalog' },
  { name: 'Hukum & Hak', count: 256, icon: 'fa-gavel', color: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300', hoverColor: 'hover:bg-emerald-50 dark:hover:bg-emerald-900/60 hover:shadow-emerald-200/50 dark:hover:shadow-emerald-500/20', href: '/katalog' },
  { name: 'Kesehatan Mental', count: 189, icon: 'fa-heart', color: 'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300', hoverColor: 'hover:bg-rose-50 dark:hover:bg-rose-900/60 hover:shadow-rose-200/50 dark:hover:shadow-rose-500/20', href: '/katalog' },
  { name: 'Wirausaha', count: 302, icon: 'fa-rocket', color: 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300', hoverColor: 'hover:bg-violet-50 dark:hover:bg-violet-900/60 hover:shadow-violet-200/50 dark:hover:shadow-violet-500/20', href: '/katalog' },
  { name: 'Pendidikan', count: 445, icon: 'fa-graduation-cap', color: 'bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-300', hoverColor: 'hover:bg-sky-50 dark:hover:bg-sky-900/60 hover:shadow-sky-200/50 dark:hover:shadow-sky-500/20', href: '/katalog' },
];

const testimonials = [
  {
    quote: 'Buka Pintu membantu saya belajar manajemen bisnis. Sekarang saya punya warung sendiri dan sudah punya 3 karyawan.',
    name: 'Hendra Pratama',
    role: 'Pengusaha Warung',
    location: 'Jawa Barat',
    initials: 'HP',
    gradient: 'from-amber-400 to-orange-500',
  },
  {
    quote: 'Saya tidak punya uang untuk kursus bahasa Inggris. Melalui Buka Pintu, saya bisa belajar sendiri dan sekarang sudah lancar bekerja di hotel.',
    name: 'Siti Aminah',
    role: 'Staff Hotel',
    location: 'Surabaya',
    initials: 'SA',
    gradient: 'from-blue-400 to-cyan-500',
  },
  {
    quote: 'Buku hukum di Buka Pintu membantu saya memahami hak-hak saya. Pengetahuan itu sangat berharga.',
    name: 'Ahmad Fauzi',
    role: 'Aktivis Sosial',
    location: 'Yogyakarta',
    initials: 'AF',
    gradient: 'from-emerald-400 to-teal-500',
  },
];
---

<Layout title="Beranda">

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center overflow-hidden">

    <!-- Dynamic Background Slideshow with Parallax -->
    <HeroBackground client:load />

    <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-24 lg:py-0 lg:min-h-screen flex items-center w-full">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center w-full">

        <!-- Text -->
        <div class="space-y-6 lg:space-y-8 z-10">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-md border border-white/30 rounded-full text-sm font-semibold text-white animate-fade-in">
            <i class="fas fa-sparkles"></i>
            100% Gratis & Terbuka untuk Semua
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-extrabold leading-[1.05] text-white tracking-tight">
            Setiap Pintu<br>
            <span class="bg-gradient-to-r from-orange-400 via-orange-300 to-green-400 bg-clip-text text-transparent animate-gradient-shift" style="background-size: 200% 200%">Terbuka</span><br>
            untuk Anda
          </h1>

          <p class="text-base sm:text-lg md:text-xl text-white/90 max-w-lg leading-relaxed">
            Perpustakaan digital gratis yang dirancang untuk membantu masyarakat Indonesia membangun kehidupan yang lebih baik melalui pengetahuan dan keterampilan.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
            <a href="/katalog" class="group inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-4 bg-gradient-to-r from-orange-500 to-green-600 text-white font-bold rounded-full hover:shadow-glow-btn-hover hover:-translate-y-1 transition-all duration-300 text-sm sm:text-base">
              <i class="fas fa-book-open group-hover:animate-bounce-subtle"></i>
              Jelajahi Katalog
            </a>
            <a href="/tentang" class="group inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-4 bg-white/20 backdrop-blur-md border border-white/30 text-white font-bold rounded-full hover:bg-white/30 hover:shadow-lg transition-all text-sm sm:text-base">
              <i class="fas fa-info-circle group-hover:animate-wiggle"></i>
              Pelajari Lebih
            </a>
          </div>

          <div class="flex flex-wrap gap-4 sm:gap-6 pt-2">
            <span class="flex items-center gap-2 text-xs sm:text-sm text-white/80 font-medium">
              <i class="fas fa-shield-alt text-green-400"></i>
              Tanpa biaya tersembunyi
            </span>
            <span class="flex items-center gap-2 text-xs sm:text-sm text-white/80 font-medium">
              <i class="fas fa-globe text-orange-400"></i>
              Akses di mana saja
            </span>
            <span class="flex items-center gap-2 text-xs sm:text-sm text-white/80 font-medium">
              <i class="fas fa-mobile-alt text-blue-400"></i>
              Mobile-friendly
            </span>
          </div>
        </div>

      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/60 animate-bounce z-10">
      <span class="text-xs font-medium">Scroll</span>
      <i class="fas fa-chevron-down text-sm"></i>
    </div>
  </section>

  <!-- STATS -->
  <section class="py-16 lg:py-20 bg-white dark:bg-gray-900 border-y border-gray-100 dark:border-gray-800">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        {stats.map((stat, index) => (
          <div class="group text-center p-4 sm:p-6 rounded-2xl bg-warm-50 dark:bg-gray-800 border border-orange-100/50 dark:border-gray-700 hover:shadow-card-lift hover:-translate-y-1 transition-all duration-300 animate-fade-in" style={`animation-delay: ${index * 100}ms`}>
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-orange-500 to-green-600 rounded-xl flex items-center justify-center mx-auto mb-3 shadow-md group-hover:animate-wiggle transition-transform">
              <i class={`fas ${stat.icon} text-white text-sm sm:text-base`}></i>
            </div>
            <div class="text-2xl sm:text-3xl font-display font-extrabold bg-gradient-to-r from-orange-500 to-green-500 bg-clip-text text-transparent mb-1">{stat.value}</div>
            <div class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED BOOKS -->
  <section class="py-20 lg:py-28 bg-warm-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10 lg:mb-12">
        <div>
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 rounded-full text-sm font-semibold mb-3">
            <i class="fas fa-star"></i> Pilihan Editor
          </span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 dark:text-white">
            Buku Pilihan <span class="bg-gradient-to-r from-orange-500 to-green-500 bg-clip-text text-transparent">untuk Anda</span>
          </h2>
          <p class="text-gray-500 dark:text-gray-400 mt-2 lg:mt-3">Koleksi kurasi terbaik untuk perjalanan Anda.</p>
        </div>
        <a href="/katalog" class="group inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 font-semibold rounded-full hover:border-orange-400 dark:hover:border-orange-500 hover:bg-orange-50 dark:hover:bg-orange-900/30 hover:shadow-lg transition-all duration-300 flex-shrink-0">
          Lihat Semua <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>

      <FeaturedBooks client:load />
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="py-20 lg:py-28 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="text-center mb-14 lg:mb-16">
        <span class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-sm font-semibold mb-4">
          <i class="fas fa-play-circle"></i> Cara Kerja
        </span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 dark:text-white mb-4">
          Tiga Langkah Mudah<br>
          <span class="bg-gradient-to-r from-orange-500 to-green-500 bg-clip-text text-transparent">Memulai Perjalanan Baru</span>
        </h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">Tidak perlu biaya, tidak perlu mendaftar. Cukup cari dan mulai membaca.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 lg:gap-12 relative">
        <div class="hidden md:block absolute top-20 left-1/4 right-1/4 h-0.5 bg-gradient-to-r from-orange-300 via-green-300 to-blue-300 rounded-full -z-10"></div>
        {steps.map((step, index) => (
          <div class="group text-center">
            <div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-green-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg group-hover:scale-110 group-hover:shadow-glow-btn transition-all duration-300">
              <i class={`fas ${step.icon} text-white text-xl`}></i>
            </div>
            <div class="text-5xl font-display font-extrabold text-orange-100 dark:text-orange-900 mb-3 select-none">{step.num}</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2">{step.title}</h3>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed max-w-xs mx-auto">{step.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-14">
        <a href="/katalog" class="group inline-flex items-center gap-2 px-10 py-4 bg-gradient-to-r from-orange-500 to-green-600 text-white font-bold rounded-full hover:shadow-glow-btn-hover hover:-translate-y-1 transition-all duration-300 text-base">
          <i class="fas fa-rocket group-hover:animate-bounce-subtle"></i>
          Mulai Sekarang - Gratis!
        </a>
      </div>
    </div>
  </section>

  <!-- CATEGORIES - Enhanced for Mobile -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-warm-50 to-white dark:from-gray-900 dark:via-gray-900 dark:to-gray-950">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-12">
      <div class="text-center mb-10 lg:mb-14">
        <span class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full text-sm font-semibold mb-4">
          <i class="fas fa-th-large"></i> Kategori
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 dark:text-white mb-3 lg:mb-4">
          Jelajahi berdasarkan <span class="bg-gradient-to-r from-orange-500 to-green-500 bg-clip-text text-transparent">Topik</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-sm sm:text-base lg:text-lg max-w-lg mx-auto px-2">
          Temukan pengetahuan yang Anda butuhkan untuk membangun kehidupan baru.
        </p>
      </div>

      <!-- Categories Grid - Optimized for Mobile -->
      <div class="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 lg:gap-5">
        {categories.map((cat, index) => (
          <a href={cat.href}
             class="group flex items-center gap-3 sm:gap-4 p-3 sm:p-4 lg:p-5
                    bg-white dark:bg-gray-800
                    rounded-xl sm:rounded-2xl
                    border border-gray-100 dark:border-gray-700
                    shadow-sm dark:shadow-lg dark:shadow-gray-900/50
                    hover:shadow-lg sm:hover:shadow-xl sm:hover:-translate-y-1
                    transition-all duration-300 animate-slide-up
                    dark:hover:border-orange-500/30 dark:hover:bg-gray-750"
             style={`animation-delay: ${index * 50}ms`}>
            <!-- Icon -->
            <div class={`w-11 h-11 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center flex-shrink-0 transition-all duration-300 ${cat.color} ${cat.hoverColor} group-hover:scale-110`}>
              <i class={`fas ${cat.icon} text-base sm:text-lg`}></i>
            </div>

            <!-- Text Content -->
            <div class="flex-1 min-w-0">
              <p class="font-bold text-gray-900 dark:text-gray-100 text-sm sm:text-base group-hover:text-orange-700 dark:group-hover:text-orange-400 transition-colors truncate">
                {cat.name}
              </p>
              <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-0.5">
                {cat.count} judul
              </p>
            </div>

            <!-- Arrow -->
            <i class="fas fa-arrow-right text-gray-300 dark:text-gray-600 group-hover:translate-x-2 group-hover:text-orange-500 dark:group-hover:text-orange-400 transition-all duration-300 flex-shrink-0"></i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSION -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-gray-900 via-gray-900 to-gray-800 dark:from-gray-900 dark:via-gray-900 dark:to-gray-950 text-white relative overflow-hidden">
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    <!-- Decorative gradient orbs (subtle) -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-to-br from-orange-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-to-tr from-green-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-orange-500/20 text-orange-300 rounded-full text-sm font-semibold mb-5">
            <i class="fas fa-seedling"></i> Misi Kami
          </span>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold mb-6 leading-tight">
            Pengetahuan adalah<br><span class="text-orange-400">kunci pembuka pintu</span>
          </h2>
          <p class="text-gray-400 leading-relaxed mb-8">
            Kami percaya bahwa setiap orang berhak mendapatkan kesempatan untuk terus belajar dan berkembang. Buka Pintu lahir dari kesadaran bahwa banyak masyarakat Indonesia menghadapi hambatan besar dalam mengakses pendidikan dan keterampilan — padahal inilah yang paling dibutuhkan untuk membangun masa depan yang lebih baik.
          </p>
          <div class="space-y-3 mb-8">
            <div class="flex items-center gap-3">
              <i class="fas fa-check-circle text-green-400"></i>
              <span class="text-gray-300 text-sm">Akses 100% gratis ke ribuan koleksi buku</span>
            </div>
            <div class="flex items-center gap-3">
              <i class="fas fa-check-circle text-green-400"></i>
              <span class="text-gray-300 text-sm">Berbasis komunitas - siapa pun bisa berkontribusi</span>
            </div>
            <div class="flex items-center gap-3">
              <i class="fas fa-check-circle text-green-400"></i>
              <span class="text-gray-300 text-sm">Dirancang untuk pengguna dengan keterbatasan akses internet</span>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/katalog" class="group inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-orange-500 to-green-600 text-white font-bold rounded-full hover:shadow-glow-btn-hover hover:-translate-y-1 transition-all duration-300">
              <i class="fas fa-book-open group-hover:animate-bounce-subtle"></i> Mulai Membaca
            </a>
            <a href="/sumber-daya" class="group inline-flex items-center gap-2 px-6 py-3 bg-white/10 backdrop-blur border border-white/20 text-white font-medium rounded-full hover:bg-white/20 hover:shadow-lg transition-all duration-300">
              <i class="fas fa-folder-open group-hover:animate-wiggle"></i> Sumber Daya
            </a>
          </div>
        </div>

        <div class="hidden lg:block">
          <div class="relative bg-gradient-to-br from-gray-800/80 to-gray-900/80 backdrop-blur-sm border border-white/10 rounded-3xl p-8 shadow-2xl">
            <div class="space-y-4">
              <div class="group flex items-center gap-3 p-4 rounded-xl hover:bg-white/5 transition-all duration-300">
                <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform shadow-lg shadow-orange-500/20">
                  <i class="fas fa-door-open text-white"></i>
                </div>
                <div>
                  <p class="font-bold text-white text-sm">Buka Pintu</p>
                  <p class="text-gray-400 text-xs">Perpustakaan Digital</p>
                </div>
              </div>
              <div class="group flex items-center gap-3 p-4 rounded-xl hover:bg-white/5 transition-all duration-300">
                <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform shadow-lg shadow-blue-500/20">
                  <i class="fas fa-book text-white"></i>
                </div>
                <div>
                  <p class="font-bold text-white text-sm">Kelola Koleksi</p>
                  <p class="text-gray-400 text-xs">tambah & edit buku</p>
                </div>
              </div>
              <div class="group flex items-center gap-3 p-4 rounded-xl hover:bg-white/5 transition-all duration-300">
                <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform shadow-lg shadow-emerald-500/20">
                  <i class="fas fa-graduation-cap text-white"></i>
                </div>
                <div>
                  <p class="font-bold text-white text-sm">Keterampilan</p>
                  <p class="text-gray-400 text-xs">belajar tanpa batas</p>
                </div>
              </div>
              <div class="group flex items-center gap-3 p-4 rounded-xl bg-gradient-to-r from-orange-500/20 to-green-500/20 border border-orange-500/20 hover:from-orange-500/30 hover:to-green-500/30 transition-all duration-300">
                <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-green-500 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform shadow-lg shadow-orange-500/30">
                  <i class="fas fa-rocket text-white"></i>
                </div>
                <div>
                  <p class="font-bold text-orange-300 text-sm">Mulai Ulang</p>
                  <p class="text-gray-400 text-xs">kesempatan baru menanti</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="py-20 lg:py-28 bg-warm-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="text-center mb-12 lg:mb-14">
        <span class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-sm font-semibold mb-4">
          <i class="fas fa-comments"></i> Kisah Mereka
        </span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 dark:text-white mb-4">
          Cerita dari <span class="bg-gradient-to-r from-orange-500 to-green-500 bg-clip-text text-transparent">Pengguna Kami</span>
        </h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-lg mx-auto">Dengarkan pengalaman nyata dari pengguna yang telah merasakan manfaat Buka Pintu.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {testimonials.map((t, index) => (
          <div class="group bg-white dark:bg-gray-800 rounded-2xl p-6 lg:p-8 shadow-lg shadow-gray-200/50 dark:shadow-none border border-gray-100 dark:border-gray-700 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col h-full animate-slide-up" style={`animation-delay: ${index * 100}ms`}>
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => <i class="fas fa-star text-amber-400 text-sm"></i>)}
            </div>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm flex-1 mb-6">"{t.quote}"</p>
            <div class="flex items-center gap-3 pt-4 border-t border-gray-100 dark:border-gray-700">
              <div class={`w-11 h-11 bg-gradient-to-br ${t.gradient} rounded-xl flex items-center justify-center text-white font-bold text-sm flex-shrink-0 group-hover:scale-110 transition-transform`}>
                {t.initials}
              </div>
              <div>
                <p class="font-bold text-gray-900 dark:text-gray-100 text-sm">{t.name}</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">{t.role}</p>
                <p class="text-xs text-gray-400 dark:text-gray-500"><i class="fas fa-map-marker-alt text-orange-400 mr-1"></i>{t.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 lg:py-24 bg-gradient-to-br from-orange-500 via-orange-400 to-green-600 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-white rounded-full blur-3xl translate-x-1/3 -translate-y-1/3"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-white rounded-full blur-3xl -translate-x-1/3 translate-y-1/3"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 text-center">
      <div class="w-20 h-20 bg-white/20 backdrop-blur rounded-2xl flex items-center justify-center mx-auto mb-8 animate-float">
        <i class="fas fa-door-open text-white text-3xl"></i>
      </div>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold mb-5 leading-tight">Pintu Kesempatan<br>Sedang Terbuka</h2>
      <p class="text-white/80 text-lg mb-10 max-w-2xl mx-auto">
        Jangan biarkan apa pun menutup peluang Anda. Mulai jelajahi pengetahuan hari ini dan bangun masa depan yang Anda impikan.
      </p>
      <div class="flex justify-center">
        <a href="/katalog" class="group inline-flex items-center justify-center gap-3 px-10 py-4 bg-white text-orange-700 font-bold rounded-full hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 text-lg">
          <i class="fas fa-book-open group-hover:animate-bounce-subtle"></i>
          Jelajahi Sekarang
        </a>
      </div>
  </section>

</Layout>
