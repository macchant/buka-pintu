---
import Layout from '../layouts/Layout.astro';
import HeroBackground from '../components/HeroBackground.jsx';

const quotes = [
  {
    quote: 'Pengetahuan adalah kunci yang membuka setiap pintu. Terima kasih Buka Pintu telah membuka jendela dunia untuk saya.',
    name: 'Siti Aminah',
    role: 'Guru SD, Jawa Timur',
    avatar: 'SA',
    color: 'from-amber-400 to-orange-500',
  },
  {
    quote: 'Saya tidak punya akses ke kursus mahal, tapi melalui Buka Pintu saya bisa belajar bahasa Inggris sendiri dan sekarang bekerja di hotel.',
    name: 'Hendra Pratama',
    role: 'Entrepreneur, Bandung',
    avatar: 'HP',
    color: 'from-blue-400 to-cyan-500',
  },
  {
    quote: 'Buku-buku hukum di sini membantu saya memahami hak-hak saya. Pengetahuan itu sangat berharga bagi siapa pun.',
    name: 'Dewi Kusuma',
    role: 'Pengacara, Jakarta',
    avatar: 'DK',
    color: 'from-emerald-400 to-teal-500',
  },
];

const values = [
  { icon: 'fa-hand-holding-heart', title: 'Inklusivitas', desc: 'Setiap orang berhak mengakses pengetahuan, tanpa memandang latar belakang.' },
  { icon: 'fa-lock-open', title: 'Keterbukaan', desc: 'Semua konten bersifat terbuka dan dapat diakses oleh siapa saja, kapan saja.' },
  { icon: 'fa-users', title: 'Komunitas', desc: 'Kami dibangun oleh komunitas, untuk komunitas — melalui gotong royong dan solidaritas.' },
  { icon: 'fa-seedling', title: 'Pertumbuhan', desc: 'Pengetahuan adalah biji yang tumbuh. Kami hadir sebagai pupuk untuk pertumbuhan Anda.' },
];

const partners = [
  { name: 'Open Library', type: 'Partner Data', icon: 'fa-book' },
  { name: 'Internet Archive', type: 'Partner Hosting', icon: 'fa-archive' },
  { name: 'Kementerian Hukum', type: 'Mitra Resmi', icon: 'fa-landmark' },
  { name: 'Komunitas Sobat Berbagi', type: 'Mitra Komunitas', icon: 'fa-hands-helping' },
];

const storyStats = [
  { year: '2023', label: 'Buka Pintu didirikan', icon: 'fa-calendar-check', iconBg: 'bg-brand-100 dark:bg-brand-900/40', iconColor: 'text-brand-600 dark:text-brand-400', valueBg: 'bg-white dark:bg-gray-800', valueText: 'text-gray-900 dark:text-gray-100' },
  { year: '2.500+', label: 'Buku tersedia', icon: 'fa-book-open', iconBg: 'bg-forest-100 dark:bg-forest-900/40', iconColor: 'text-forest-600 dark:text-forest-400', valueBg: 'bg-white dark:bg-gray-800', valueText: 'text-gray-900 dark:text-gray-100' },
  { year: '1.200+', label: 'Pengguna aktif', icon: 'fa-users', iconBg: 'bg-sky-100 dark:bg-sky-900/40', iconColor: 'text-sky-600 dark:text-sky-400', valueBg: 'bg-white dark:bg-gray-800', valueText: 'text-gray-900 dark:text-gray-100' },
  { year: '100%', label: 'Gratis', icon: 'fa-heart', iconBg: 'bg-brand-50 dark:bg-brand-900/40', iconColor: 'text-brand-500 dark:text-brand-400', valueBg: 'bg-brand-50 dark:bg-brand-900/40', valueText: 'text-brand-700 dark:text-brand-300', border: 'border-2 border-brand-200 dark:border-brand-800' },
];
---

<Layout title="Tentang Kami" description="Kenali kisah di balik Buka Pintu — perpustakaan digital gratis untuk masyarakat Indonesia.">

  <!-- Hero with Background Image -->
  <section class="relative min-h-[70vh] flex items-center overflow-hidden">

    <!-- Background Image with Parallax -->
    <HeroBackground client:load />

    <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-20 lg:py-0 flex items-center w-full">
      <div class="max-w-3xl mx-auto text-center z-10">
        <!-- Logo Icon -->
        <div class="w-20 h-20 md:w-24 md:h-24 bg-gradient-to-br from-brand-500 to-forest-500 rounded-2xl md:rounded-3xl flex items-center justify-center mx-auto mb-6 md:mb-8 shadow-2xl shadow-brand-500/30 animate-fade-in">
          <i class="fas fa-door-open text-white text-3xl md:text-4xl"></i>
        </div>

        <!-- Tag -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-md border border-white/30 rounded-full text-sm font-semibold text-white mb-6 animate-fade-in">
          <i class="fas fa-heart text-rose-400"></i>
          Kisah di Balik Buka Pintu
        </div>

        <!-- Heading with font-display -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-extrabold mb-4 md:mb-6 leading-[1.05] text-white tracking-tight animate-slide-up">
          Buka Pintu<br>
          <span class="bg-gradient-to-r from-orange-400 via-orange-300 to-green-400 bg-clip-text text-transparent animate-gradient-shift" style="background-size: 200% 200%">Buka Kesempatan</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg md:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed animate-slide-up" style="animation-delay: 0.1s">
          Kami percaya bahwa setiap orang berhak mendapatkan kesempatan untuk membangun kehidupan yang bermartabat — dimulai dari akses terhadap pengetahuan.
        </p>

        <!-- Scroll indicator -->
        <div class="mt-10 animate-bounce">
          <div class="inline-flex items-center gap-2 text-white/60 text-sm">
            <span>Scroll untuk melihat</span>
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-16 md:py-24 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-5 md:px-6">
      <div class="grid lg:grid-cols-2 gap-10 md:gap-16 items-center">
        <div>
          <span class="tag bg-brand-100 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 mb-4">📖 Kisah Kami</span>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-display font-extrabold text-gray-900 dark:text-white mb-6 leading-tight">
            Membuka Pintu,<br/><span class="gradient-text">Membangun Masa Depan</span>
          </h2>
          <div class="space-y-4 text-gray-600 dark:text-gray-400 leading-relaxed">
            <p>
              Buka Pintu lahir pada tahun 2023 dari keprihatinan terhadap terbatasnya akses pendidikan bagi masyarakat di Indonesia. Banyak orang memiliki keinginan kuat untuk berubah dan belajar, namun tidak memiliki sumber daya untuk melakukannya.
            </p>
            <p>
              Dari situlah muncul ide untuk membangun <strong class="text-gray-900 dark:text-gray-100">perpustakaan digital gratis</strong> yang bisa diakses siapa saja, kapan saja — tanpa biaya, tanpa batasan, tanpa stigma.
            </p>
          </div>
        </div>
        <div class="relative">
          <div class="bg-gradient-to-br from-brand-50 to-forest-50 dark:from-gray-800 dark:to-gray-800 rounded-2xl md:rounded-3xl p-6 md:p-10 space-y-4 md:space-y-6">
            {storyStats.map((stat) => (
              <div class={`flex items-center gap-4 rounded-xl md:rounded-2xl p-4 md:p-5 shadow-sm ${stat.valueBg} ${stat.border || ''}`}>
                <div class={`w-12 h-12 md:w-14 md:h-14 ${stat.iconBg} rounded-xl flex items-center justify-center flex-shrink-0`}>
                  <i class={`fas ${stat.icon} ${stat.iconColor} text-xl md:text-2xl`}></i>
                </div>
                <div>
                  <p class={`font-bold ${stat.valueText}`}>{stat.year}</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{stat.label}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-16 md:py-24 bg-warm-50 dark:bg-gray-800">
    <div class="max-w-7xl mx-auto px-5 md:px-6">
      <div class="text-center mb-10 md:mb-14">
        <span class="tag bg-forest-100 dark:bg-forest-900/40 text-forest-700 dark:text-forest-300 mb-4">💡 Nilai-Nilai Kami</span>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-display font-extrabold text-gray-900 dark:text-white">
          Prinsip yang <span class="gradient-text">Kami Pegang</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {values.map((v) => (
          <div class="bg-white dark:bg-gray-900 rounded-xl md:rounded-2xl p-5 md:p-7 border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-gradient-to-br from-brand-500 to-forest-500 rounded-xl md:rounded-2xl flex items-center justify-center mb-4 md:mb-5">
              <i class={`fas ${v.icon} text-white text-lg md:text-xl`}></i>
            </div>
            <h3 class="font-bold text-gray-900 dark:text-gray-100 text-base md:text-lg mb-2">{v.title}</h3>
            <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Community Voices -->
  <section class="py-16 md:py-24 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-5 md:px-6">
      <div class="text-center mb-10 md:mb-14">
        <span class="tag bg-brand-100 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 mb-4">💬 Suara Komunitas</span>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-display font-extrabold text-gray-900 dark:text-white">
          Apa yang Mereka <span class="gradient-text">Katakan</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {quotes.map((q) => (
          <div class="bg-white dark:bg-gray-800 rounded-xl md:rounded-2xl p-6 md:p-8 shadow-lg dark:shadow-gray-900/50 border border-gray-100 dark:border-gray-700 hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col h-full">
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => <i class="fas fa-star text-amber-400 text-sm"></i>)}
            </div>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-sm flex-1 mb-6">"{q.quote}"</p>
            <div class="flex items-center gap-3 pt-4 border-t border-gray-100 dark:border-gray-700">
              <div class={`w-11 h-11 bg-gradient-to-br ${q.color} rounded-xl flex items-center justify-center text-white font-bold text-sm flex-shrink-0`}>
                {q.avatar}
              </div>
              <div>
                <p class="font-bold text-gray-900 dark:text-gray-100 text-sm">{q.name}</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">{q.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-900 via-gray-900 to-gray-800 dark:from-gray-950 dark:via-gray-900 dark:to-gray-950 text-white relative overflow-hidden">
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    <!-- Decorative gradient orbs -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-to-br from-brand-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-to-tr from-forest-500/10 to-transparent rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-5 md:px-6">
      <div class="text-center mb-10 md:mb-14">
        <span class="tag bg-brand-500/20 text-brand-300 mb-4">🤝 Mitra & Partner</span>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-display font-extrabold">
          Didukung oleh <span class="text-brand-400">Komunitas</span>
        </h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-5">
        {partners.map((p) => (
          <div class="bg-white/5 border border-white/10 rounded-xl md:rounded-2xl p-4 md:p-6 text-center hover:bg-white/10 transition-all">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-brand-500/20 rounded-xl flex items-center justify-center mx-auto mb-3 md:mb-4">
              <i class={`fas ${p.icon} text-brand-400 text-xl md:text-2xl`}></i>
            </div>
            <p class="font-bold text-white text-sm md:text-base">{p.name}</p>
            <p class="text-gray-500 text-xs md:text-sm mt-1">{p.type}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
